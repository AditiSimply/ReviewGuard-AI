# ReviewGuard AI - Backend Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection URI (Optional: Leave blank or default to use Resilient File-Backed Storage)
MONGODB_URI=mongodb://127.0.0.1:27017/reviewguard

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Token Lifetime
TOKEN_EXPIRY=24h

# Environment Mode
NODE_ENV=development

# Initial Administrator Provisioning (Used by `npm run seed`)
ADMIN_EMAIL=admin@reviewguard.ai
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=ReviewGuard Administrator
