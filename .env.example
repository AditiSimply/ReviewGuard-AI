# ReviewGuard AI - Root Environment Example

# Backend Server Port
PORT=5000

# MongoDB Connection String (Leave default or blank to use atomic local file storage)
MONGODB_URI=mongodb://127.0.0.1:27017/reviewguard

# JSON Web Token Secret Key
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Token Validity Duration
TOKEN_EXPIRY=24h

# Environment Mode (development / production)
NODE_ENV=development

# First Administrator Seed Credentials (Executed via: npm run seed in backend/)
ADMIN_EMAIL=admin@reviewguard.ai
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=ReviewGuard Administrator
